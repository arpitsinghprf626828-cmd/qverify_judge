# Copy to .env and fill in. Never commit .env.  The app REFUSES to start with QV_DEMO=0 if QV_KEY_PASSPHRASE is empty or any value still says "change-me".
DOMAIN=qverify.example.com
ACME_EMAIL=you@example.com
QV_DEMO=0
QV_SEED_DEMO=1
QV_KEY_PASSPHRASE=change-me-long-random-passphrase
QV_IDLE_MINUTES=30
QV_PW_ADMIN1=change-me-admin
QV_PW_REVIEWER1=change-me-reviewer
QV_PW_AUDITOR1=change-me-auditor
QV_PW_APPLICANT1=change-me-applicant
# Optional: public evaluator login (user judge1). The password is SHOWN on the login page. Remove this line after the evaluation.
# QV_JUDGE_PASSWORD=choose-a-judge-password
